<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic globally for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">198.199.81.112</domain>
        <domain includeSubdomains="true">fpbiometric.swsam.co.uk</domain>
        <domain includeSubdomains="true">fpbiometricdemo.swsam.co.uk</domain>           
        <!-- Allow cleartext traffic for React Native Metro bundler -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.250.89</domain>
    </domain-config>
</network-security-config>